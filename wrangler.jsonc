{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "propertymediajapan",
  "compatibility_date": "2026-05-09",
  "observability": {
    "enabled": true
  },
  "main": "_worker/media.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/media/*"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
