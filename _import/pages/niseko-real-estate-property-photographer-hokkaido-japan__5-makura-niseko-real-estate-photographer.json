    "sourceUrl" : "",
    "body" : "<div class=\"sqs-layout sqs-grid-12 columns-12\" data-layout-label=\"Post Body\" data-type=\"item\" data-updated-on=\"1730263341951\" id=\"item-6721b79d112f5d23648dd388\"><div class=\"row sqs-row\"><div class=\"col sqs-col-12 span-12\"><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-video video-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.video/34a613e1-1219-44af-8e10-2e3cccacdd21_736/website.components.video.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.video/34a613e1-1219-44af-8e10-2e3cccacdd21_736/34418.js&quot;,&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.video/34a613e1-1219-44af-8e10-2e3cccacdd21_736/website.components.video.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.video\" data-sqsp-block=\"video\" data-website-component-id=\"yui_3_17_2_1_1731918150517_19483\" id=\"block-yui_3_17_2_1_1731918150517_19483\"><div class=\"sqs-block-content\">\n  \n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n  \n\n\n\n\n\n\n\n\n\n\n\n  \n    \n  \n  <div class=\"intrinsic\" style=\"max-width:100%\">\n    <div class=\"embed-block-wrapper\">\n      <div\n        class=\"sqs-native-video\"\n        data-config-settings=\"\"\n        data-config-video=\"{&quot;systemDataSourceType&quot;:&quot;mp4&quot;,&quot;alexandriaUrl&quot;:&quot;https://video.squarespace-cdn.com/content/v1/66c59c726b45c63a433f4c32/fcc00200-959c-4555-828d-b0d2f0c9f5d9/{variant}&quot;,&quot;durationSeconds&quot;:79.32,&quot;aspectRatio&quot;:1.7796296296296297,&quot;id&quot;:&quot;673ef185e9f72c75bb4be906&quot;,&quot;systemDataVariants&quot;:&quot;1922:1080,640:360&quot;,&quot;alexandriaLibraryId&quot;:&quot;66c59c726b45c63a433f4c32&quot;,&quot;audioCodec&quot;:&quot;aac&quot;,&quot;systemDataId&