    "body" : "<div class=\"sqs-layout sqs-grid-12 columns-12\" data-layout-label=\"Post Body\" data-type=\"item\" data-updated-on=\"1728892745864\" id=\"item-670ccbf3ff3b4815b5a92712\"><div class=\"row sqs-row\"><div class=\"col sqs-col-12 span-12\"><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-video video-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.video/34a613e1-1219-44af-8e10-2e3cccacdd21_736/website.components.video.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.video/34a613e1-1219-44af-8e10-2e3cccacdd21_736/34418.js&quot;,&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.video/34a613e1-1219-44af-8e10-2e3cccacdd21_736/website.components.video.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.video\" data-sqsp-block=\"video\" data-website-component-id=\"yui_3_17_2_1_1728878763848_129214\" id=\"block-yui_3_17_2_1_1728878763848_129214\"><div class=\"sqs-block-content\">\n  \n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n  \n\n\n\n\n\n\n\n\n\n\n\n  \n    \n  \n  <div class=\"intrinsic\" style=\"max-width:100%\">\n    <div class=\"embed-block-wrapper\">\n      <div\n        class=\"sqs-native-video\"\n        data-config-settings=\"\"\n        data-config-video=\"{&quot;systemDataSourceType&quot;:&quot;mp4&quot;,&quot;alexandriaUrl&quot;:&quot;https://video.squarespace-cdn.com/content/v1/66c59c726b45c63a433f4c32/08237481-8e82-4c55-87e9-cb03ee2e8447/{variant}&quot;,&quot;durationSeconds&quot;:74.699625,&quot;aspectRatio&quot;:1.7777777777777777,&quot;id&quot;:&quot;670ccc1978d2e23ca4b06b96&quot;,&quot;systemDataVariants&quot;:&quot;1920:1080,640:360&quot;,&quot;alexandriaLibraryId&quot;:&quot;66c59c726b45c63a433f4c32&quot;,&quot;audioCodec&quot;:&quot;aac&quot;,&quot;systemDataId&quot;:&quot;08237481-8e82-4c55-87e9-cb03ee2e8447&quot;,&quot;videoCodec&quot;:&quot;h264&quot;}\"\n        data-config-loading=\"\"\n        data-config-thumbnail=\"{&quot;mediaFocalPoint&quot;:{&quot;x&quot;:0.5,&quot;y&quot;:0.5,&quot;source&quot;:3},&quot;assetUrl&quot;:&quot;https://images.squarespace-cdn.com/content/v1/66c59c726b45c63a433f4c32/e3e1838d-7016-4728-b876-a7750b07911a/A1_08205.jpg&quot;}\"\n      >\n        <div\n          class=\"native-video-player\"\n          style=\"aspect-ratio:16/9;\"\n        >\n          \n        </div>\n      </div>\n    </div>\n    \n    \n\n\n\n  </div>\n\n\n\n\n<style class=\"transform-overrides-vars\">\n  \n</style>\n\n\n\n  \n  \n  \n<style id=\"container-styles\">#block-yui_3_17_2_1_1728878763848_129214 {\n    \n    \n    \n  }\n\n  #block-yui_3_17_2_1_1728878763848_129214 .intrinsic {\n    \n    }\n\n  #block-yui_3_17_2_1_1728878763848_129214 {\n      mix-blend-mode: var(--tweak-video-block-blend);\n      border-radius: var(--tweak-video-block-radius);\n  }\n\n  \n  \n\n\n\n  \n  \n\n  \n</style>\n\n<style id=\"override-container-styles\">\n    @media screen and (max-width: 767px) {\n          \n            \n\n#block-yui_3_17_2_1_1728878763848_129214 {\n            \n            }\n        }\n    \n  \n    @media screen and (max-width: 767px) {\n          #block-yui_3_17_2_1_1728878763848_129214 .intrinsic {\n            \n            }\n        }\n    \n  @media screen and (max-width: 767px) {\n          \n          \n\n          \n          \n          \n        }</style>\n\n  <style>#block-yui_3_17_2_1_1728878763848_129214 { border-width: 0; height: auto; }</style>\n  \n  \n  \n    <style>\n    \n      \n    \n      \n        @media screen and (max-width: 767px) {\n          #block-yui_3_17_2_1_1728878763848_129214 { background-color: transparent; }\n          #block-yui_3_17_2_1_1728878763848_129214 .intrinsic { background-color: var(--tweak-video-block-background-color); }\n        }\n      \n    \n    </style>\n  \n\n</div></div><div class=\"sqs-block html-block sqs-block-html\" data-block-type=\"2\" data-sqsp-block=\"text\" id=\"block-972ab18ee579a35168a8\"><div class=\"sqs-block-content\">\n\n<div class=\"sqs-html-content\" data-sqsp-text-block-content>\n  <p class=\"\" style=\"white-space:pre-wrap;\">Property Media Japan specialises in Real Estate Photography, Videography, Aerial Photography, Floor-plans and Virtual Staging. Previously based in Queenstown New Zealand, we are now operating in Niseko, Hokkaido Japan.</p><p class=\"\" data-rte-preserve-empty=\"true\" style=\"white-space:pre-wrap;\"></p><p class=\"\" style=\"white-space:pre-wrap;\">Nestled in the tranquil surroundings of Arrowtown, this delightful three-bedroom home offers a peaceful retreat with all the modern comforts. The property, set on a generously sized plot, boasts a floor size that provides ample space for family living while maintaining a cozy atmosphere.</p><p class=\"\" style=\"white-space:pre-wrap;\"><strong>Interior Features:</strong></p><ul data-rte-list=\"default\"><li><p class=\"\" style=\"white-space:pre-wrap;\"><strong>Bedrooms:</strong> 3 spacious bedrooms, each with unique views of the lush outdoor setting.</p></li><li><p class=\"\" style=\"white-space:pre-wrap;\"><strong>Bathroom:</strong> 1 well-appointed bathroom combining functionality with style.</p></li><li><p class=\"\" style=\"white-space:pre-wrap;\"><strong>Living Areas:</strong> A light-filled living room with high ceilings and exposed beams adds an open, airy feel to the home. An additional family room integrates seamlessly with the kitchen, perfect for family gatherings.</p></li></ul><p class=\"\" style=\"white-space:pre-wrap;\"><strong>Kitchen:</strong><br>A functional kitchen with modern appliances and a long counter top provides a great space for cooking and entertainment. Natural light floods the space, making it bright and inviting.</p><p class=\"\" style=\"white-space:pre-wrap;\"><strong>Exterior and Amenities:</strong></p><ul data-rte-list=\"default\"><li><p class=\"\" style=\"white-space:pre-wrap;\"><strong>Outdoor Living:</strong> Large windows and sliding doors open to a verdant garden, complete with a quaint wooden deck and covered seating area that is perfect for relaxing or hosting barbecues.</p></li><li><p class=\"\" style=\"white-space:pre-wrap;\"><strong>Garage:</strong> A single-car garage with additional space for storage.</p></li><li><p class=\"\" style=\"white-space:pre-wrap;\"><strong>Extra Features:</strong> A dedicated barbecue area on the wooden deck and ample garden space for children to play or for cultivating a garden.</p></li></ul><p class=\"\" style=\"white-space:pre-wrap;\"><strong>Location:</strong><br>Just moments away from local amenities and surrounded by nature, this home offers both privacy and convenience. Ideal for families looking for a blend of country charm and easy access to city facilities.</p><p class=\"\" style=\"white-space:pre-wrap;\"><strong>Perfect for:</strong><br>Families or individuals looking for a serene lifestyle close to nature without sacrificing convenience. Ideal for those who appreciate the beauty of the outdoors and the comfort of a thoughtfully laid out home.</p><p class=\"\" style=\"white-space:pre-wrap;\">This property promises a blend of relaxation and functionality, making it a perfect sanctuary for those looking to make their home in the beautiful region of Niseko.</p>\n</div>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n  \n  \n\n\n\n</div></div><div class=\"sqs-block gallery-block sqs-block-gallery\" data-block-json=\"&#123;&quot;existingGallery&quot;:null,&quot;hSize&quot;:null,&quot;newWindow&quot;:false,&quot;floatDir&quot;:null,&quot;methodOption&quot;:&quot;transient&quot;,&quot;aspectRatio&quot;:null,&quot;auto-crop&quot;:true,&quot;blockAnimation&quot;:&quot;none&quot;,&quot;collectionId&quot;:&quot;670cce3d71017a511d92bbdb&quot;,&quot;design&quot;:&quot;stacked&quot;,&quot;show-meta&quot;:true,&quot;show